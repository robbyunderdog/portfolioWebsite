---
import { profile } from '../data/site';

// root-relative, so the links also work from blog posts
const links = ['about', 'projects', 'homelab', 'blog', 'education', 'contact'];
---

<header>
	<nav>
		<a href="/" class="home">~/{profile.handle}</a>
		<ul>
			{links.map((link) => <li><a href={`/#${link}`}>./{link}</a></li>)}
		</ul>
	</nav>
</header>

<script>
	// Scroll to sections without leaving `#section` in the URL.
	const onHome = () => location.pathname === '/';

	document.querySelectorAll<HTMLAnchorElement>('header a[href^="/#"]').forEach((link) => {
		link.addEventListener('click', (event) => {
			if (!onHome()) return; // from a blog post, let the browser load /#section
			const target = document.getElementById(link.hash.slice(1));
			if (!target) return;
			event.preventDefault();
			target.scrollIntoView({ behavior: 'smooth' });
		});
	});

	// Arriving from another page via /#section: the browser has already jumped there, so drop the hash.
	if (onHome() && location.hash) {
		history.replaceState(null, '', location.pathname + location.search);
	}
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(6px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0.75rem 1.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		align-items: center;
		justify-content: space-between;
	}

	.home {
		color: var(--accent);
		font-weight: 700;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	ul a {
		color: var(--muted);
	}

	ul a:hover {
		color: var(--text);
		text-decoration: none;
	}
</style>
