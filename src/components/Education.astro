---
import SectionHeading from './SectionHeading.astro';
import { education, profile } from '../data/site';
---

<section id="education">
	<SectionHeading command="git log --education" />
	<ol>
		{education.map((item) => (
			<li>
				<p class="meta"><span class="period">{item.period}</span> {item.org}</p>
				<h3>{item.program}</h3>
				{item.points.length > 0 && (
					<ul>
						{item.points.map((point) => <li>{point}</li>)}
					</ul>
				)}
			</li>
		))}
	</ol>
	{profile.resumeUrl && (
		<p class="resume">
			<a href={profile.resumeUrl} target="_blank" class="prompt">wget resume.pdf</a>
		</p>
	)}
</section>

<style>
	ol {
		list-style: none;
		margin: 0;
		padding: 0 0 0 1.25rem;
		border-left: 2px solid var(--border);
	}

	ol > li {
		position: relative;
		margin-bottom: 2rem;
	}

	ol > li::before {
		content: '';
		position: absolute;
		left: calc(-1.25rem - 6px);
		top: 0.45rem;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
	}

	.meta {
		margin: 0;
		font-size: 0.8rem;
		color: var(--muted);
	}

	.period {
		color: var(--warn);
		margin-right: 0.5rem;
	}

	h3 {
		font-size: 1.05rem;
	}

	ul {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
		color: var(--muted);
		font-size: 0.875rem;
	}

	.resume a {
		color: var(--text);
	}
</style>
