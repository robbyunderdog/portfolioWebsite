---
import SectionHeading from './SectionHeading.astro';
import { contact } from '../data/site';
---

<section id="contact">
	<SectionHeading command="cat contact.txt" />
	<p class="comment">feel free to reach out</p>
	<dl>
		{contact.map((item) => (
			<>
				<dt>{item.label}</dt>
				<dd><a href={item.url} target="_blank" rel="noopener">{item.value}</a></dd>
			</>
		))}
	</dl>
</section>

<style>
	dl {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.4rem 1.5rem;
		margin: 0;
	}

	dt {
		color: var(--accent);
	}

	dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
</style>
