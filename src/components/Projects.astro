---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';
---

<section id="projects">
	<SectionHeading command="ls ~/projects" />
	<div class="grid">
		{projects.map((project) => (
			<article>
				<h3>{project.name}/</h3>
				<p>{project.description}</p>
				<ul>
					{project.tech.map((tag) => <li>{tag}</li>)}
				</ul>
				{project.url && <a href={project.url} target="_blank" rel="noopener">view source &rarr;</a>}
				{project.anchor && <a href={project.anchor}>explore the map &darr;</a>}
			</article>
		))}
	</div>
</section>

<style>
	.grid {
		display: grid;
		/* two columns on desktop, so four projects make a tidy 2×2 grid */
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
		gap: 1rem;
	}

	article {
		display: flex;
		flex-direction: column;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 1.25rem;
		transition: border-color 0.15s;
	}

	article:hover {
		border-color: var(--accent);
	}

	h3 {
		font-size: 1.05rem;
		color: var(--accent-2);
	}

	p {
		flex: 1;
		font-size: 0.875rem;
		color: var(--muted);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
	}

	li {
		font-size: 0.75rem;
		color: var(--accent);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0 0.4rem;
	}
</style>
