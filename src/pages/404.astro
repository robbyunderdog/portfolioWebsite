---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { profile } from '../data/site';
---

<Layout title={`404 · ${profile.name}`} description="Page not found">
	<Nav />
	<main>
		<section>
			<p class="prompt">cd <span id="missing-path">/404</span></p>
			<h1>404</h1>
			<p class="error">bash: cd: no such file or directory</p>
			<p class="back"><a href="/">cd ~</a></p>
		</section>
	</main>
</Layout>

<script>
	const el = document.getElementById('missing-path');
	if (el) el.textContent = decodeURIComponent(location.pathname);
</script>

<style>
	section {
		max-width: 72ch;
		margin: 0 auto;
		padding: 6rem 0 4rem;
	}

	h1 {
		font-size: 3rem;
		margin: 0.5rem 0;
		color: var(--warn);
	}

	.error {
		color: var(--muted);
	}

	.back {
		margin-top: 2rem;
	}
</style>
